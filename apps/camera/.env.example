# Copy to .env (never commit). Camera integration service (Phase 10).
APP_ENV=development
LOG_LEVEL=INFO
# Shared secret with the Core API: the SAME value as CAMERA_SERVICE_TOKEN in apps/api/.env.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=generate-me
# Core API base URL for camera configuration + status reports. Empty = standalone mode.
CORE_API_URL=http://127.0.0.1:8000
SYNC_INTERVAL_SECONDS=10
# Optional: recognition service, used ONLY by the stream quality test to measure faces.
# RECOGNITION_URL=http://127.0.0.1:8100
# RECOGNITION_TOKEN=<SERVICE_TOKEN of apps/recognition/.env>
# Folder for TEST cameras that replay images/video (default: <repo>/data/test-media, git-ignored)
# TEST_MEDIA_DIR=C:/secure/test-media
STALL_TIMEOUT_SECONDS=10
RECONNECT_INITIAL_SECONDS=1
RECONNECT_MAX_SECONDS=60
# Live recognition: frames/s sent to the recognition service for cameras with recognition enabled
# LIVE_RECOGNITION_FPS=2
