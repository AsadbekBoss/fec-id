# Copy to .env (never commit .env). Used when running the API directly on your machine.
# `npm run setup` creates .env automatically with random secrets.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attendance
POSTGRES_USER=attendance
# Set a strong local password; must match the role created in PostgreSQL (see README §Database).
POSTGRES_PASSWORD=change-me

# Master key(s) for column encryption (biometric templates, camera credentials, MFA secrets).
# Format: <key_id>:<base64url 32 bytes>[,<key_id>:<key>...]  Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
# LOSING THIS KEY MAKES ALL ENCRYPTED DATA UNREADABLE. Back it up separately from the database.
DATA_ENCRYPTION_KEYS=1:generate-me
DATA_ENCRYPTION_ACTIVE_KEY_ID=1

# Ed25519 signing key(s) for access tokens. Same format and generator as above.
# Rotation: add "2:<new>" and set JWT_ACTIVE_KEY_ID=2 (tokens signed with key 1 stay valid).
JWT_SIGNING_KEYS=1:generate-me
JWT_ACTIVE_KEY_ID=1
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
# Set to false ONLY if you serve the API over plain http on a non-localhost address (not recommended).
REFRESH_COOKIE_SECURE=true
# IPs of reverse proxies allowed to set X-Forwarded-For, e.g. ["127.0.0.1"] behind Nginx.
TRUSTED_PROXIES=[]

# Camera service (apps/camera). Leave unset until the camera service runs.
# CAMERA_SERVICE_URL=http://127.0.0.1:8200
# Same value as CAMERA_SERVICE_TOKEN / CORE_API_TOKEN in apps/camera/.env (>= 24 random chars):
# CAMERA_SERVICE_TOKEN=generate-me-with-secrets.token_urlsafe

# Optional: enables database tests (role needs CREATEDB). Tests create and drop their own DB.
# TEST_DATABASE_URL=postgresql+asyncpg://attendance:<password>@localhost:5432/postgres

# Recognition service (face enrolment). Leave unset until it runs.
# RECOGNITION_SERVICE_URL=http://127.0.0.1:8100
# Token used TO CALL the recognition service = SERVICE_TOKEN in apps/recognition/.env
# RECOGNITION_SERVICE_TOKEN=generate-me
# SEPARATE token the recognition service uses to read the encrypted gallery = CORE_API_TOKEN there.
# Never give this one to the camera service.
# RECOGNITION_GALLERY_TOKEN=generate-me
