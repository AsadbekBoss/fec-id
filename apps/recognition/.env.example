# Copy to .env (never commit). Recognition service - evaluation phase, NOT connected to attendance.
APP_ENV=development
DETECTOR=yunet
EMBEDDER=sface
# Non-commercial weights (InsightFace) only for local research, never production:
ALLOW_RESEARCH_MODELS=false
# Leave empty to use the model's reference threshold from models/manifest.yaml (then calibrate!)
# MATCH_THRESHOLD=0.40
MIN_MARGIN=0.05
UNCERTAIN_BAND=0.03
MIN_FACE_WIDTH_PX=80
# Bearer token for /internal/*: generate with python -c "import secrets;print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=generate-me
# Same keyring as apps/api/.env DATA_ENCRYPTION_KEYS (templates must stay decryptable by both)
DATA_ENCRYPTION_KEYS=1:generate-me
# GALLERY_PATH=C:/secure/gallery.json
# Gallery sync from the Core API (enrolled employees, encrypted templates)
# CORE_API_URL=http://127.0.0.1:8000
# CORE_API_TOKEN=<RECOGNITION_GALLERY_TOKEN of apps/api/.env>  (NOT the SERVICE_TOKEN)
# GALLERY_SYNC_SECONDS=30
