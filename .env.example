# Root .env — used by docker-compose.yml. Copy to .env and set real values. Never commit .env.

# PostgreSQL
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Column-encryption master key(s): "<id>:<base64url 32 bytes>". Back it up separately!
DATA_ENCRYPTION_KEYS=1:generate-me
# Ed25519 access-token signing key(s), same format.
JWT_SIGNING_KEYS=1:generate-me

# Valkey (Redis-compatible). Not used by app code until Phase 6/7.
VALKEY_PASSWORD=change-me-too
VALKEY_PORT=6379

# Recognition service (opt-in compose profile "recognition"). Bearer token for its internal API.
RECOGNITION_SERVICE_TOKEN=generate-me

# Camera service (opt-in compose profile "cameras"). Shared secret api <-> camera, >= 24 chars.
CAMERA_SERVICE_TOKEN=generate-me

# Host ports
API_PORT=8000
WEB_PORT=3000
RECOGNITION_PORT=8100
CAMERA_PORT=8200
