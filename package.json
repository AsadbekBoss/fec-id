{
  "name": "ai-employee-attendance",
  "private": true,
  "version": "0.1.0",
  "description": "AI Employee Attendance — monorepo root scripts",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "dev": "node tools/dev.mjs",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "node tools/dev.mjs api",
    "start": "node tools/run.mjs",
    "start:dev": "node tools/run.mjs --dev",
    "stop": "node tools/run.mjs --stop",
    "status": "node tools/run.mjs --status",
    "autostart": "node tools/autostart.mjs",
    "autostart:remove": "node tools/autostart.mjs --remove",
    "lint": "npm --prefix apps/web run lint && node tools/py.mjs -m ruff check . && npm run lint:rec && npm run lint:cam",
    "typecheck": "npm --prefix apps/web run typecheck && node tools/py.mjs -m mypy app && npm run typecheck:rec && npm run typecheck:cam",
    "test": "npm --prefix apps/web run test && node tools/py.mjs -m pytest -q && npm run test:rec && npm run test:cam",
    "db:init": "node tools/db-init.mjs",
    "db:migrate": "node tools/py.mjs -m alembic upgrade head",
    "db:downgrade": "node tools/py.mjs -m alembic downgrade -1",
    "db:current": "node tools/py.mjs -m alembic current",
    "db:check": "node tools/py.mjs -m alembic check",
    "db:revision": "node tools/py.mjs -m alembic revision --autogenerate -m",
    "user:create": "node tools/py.mjs -m app.cli create-user",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:web": "npm --prefix apps/web run test",
    "test:api": "node tools/py.mjs -m pytest -q",
    "rec:setup": "node tools/svc.mjs recognition setup",
    "rec:check": "node tools/svc.mjs recognition -m recognition.cli check-models",
    "rec:download": "node tools/svc.mjs recognition -m recognition.cli download-models",
    "rec:dev": "node tools/svc.mjs recognition -m uvicorn recognition.api:create_app --factory --host 127.0.0.1 --port 8100",
    "rec:bench": "node tools/svc.mjs recognition -m recognition.cli bench",
    "rec:enroll": "node tools/svc.mjs recognition -m recognition.cli enroll",
    "rec:eval": "node tools/svc.mjs recognition -m recognition.cli evaluate",
    "test:rec": "node tools/svc.mjs recognition -m pytest -q",
    "lint:rec": "node tools/svc.mjs recognition -m ruff check recognition tests",
    "typecheck:rec": "node tools/svc.mjs recognition -m mypy recognition",
    "cam:setup": "node tools/svc.mjs camera setup",
    "cam:dev": "node tools/svc.mjs camera -m uvicorn camera.api:create_app --factory --host 127.0.0.1 --port 8200",
    "test:cam": "node tools/svc.mjs camera -m pytest -q",
    "lint:cam": "node tools/svc.mjs camera -m ruff check camera tests",
    "typecheck:cam": "node tools/svc.mjs camera -m mypy camera",
    "backup": "node tools/py.mjs -m app.cli backup",
    "backup:verify": "node tools/py.mjs -m app.cli backup-verify",
    "backup:restore": "node tools/py.mjs -m app.cli backup-restore",
    "backup:keys": "node tools/py.mjs -m app.cli backup-keys",
    "backup:schedule": "node tools/backup-schedule.mjs"
  }
}
